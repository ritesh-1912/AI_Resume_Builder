{
  "buildCommand": null,
  "outputDirectory": "design-system",
  "rewrites": [
    {
      "source": "/builder",
      "destination": "/builder.html"
    },
    {
      "source": "/preview",
      "destination": "/preview.html"
    },
    {
      "source": "/rb/01-problem",
      "destination": "/rb/01-problem.html"
    },
    {
      "source": "/rb/02-market",
      "destination": "/rb/02-market.html"
    },
    {
      "source": "/rb/03-architecture",
      "destination": "/rb/03-architecture.html"
    },
    {
      "source": "/rb/04-hld",
      "destination": "/rb/04-hld.html"
    },
    {
      "source": "/rb/05-lld",
      "destination": "/rb/05-lld.html"
    },
    {
      "source": "/rb/06-build",
      "destination": "/rb/06-build.html"
    },
    {
      "source": "/rb/07-test",
      "destination": "/rb/07-test.html"
    },
    {
      "source": "/rb/08-ship",
      "destination": "/rb/08-ship.html"
    },
    {
      "source": "/rb/proof",
      "destination": "/rb/proof.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}